---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for post in site.posts %}{% unless post.sitemap == false or post.noindex %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endfor %}
{% for page in site.pages %}{% if page.layout %}{% unless page.sitemap == false or page.noindex %}
{% assign pagination_prefix = site.paginate_path | split: ':num' | first %}
{% assign page_number = page.url | remove_first: pagination_prefix | remove: '/' | plus: 0 %}
{% assign pagination_url = site.paginate_path | replace: ':num', page_number %}
{% unless page.url == pagination_url and page_number > 1 %}
  <url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endunless %}{% endif %}{% endfor %}
  <url><loc>{{ '/images/Sachie_Kobayashi_Portofolio_EN_2025_COMP.pdf' | absolute_url | xml_escape }}</loc></url>
</urlset>
